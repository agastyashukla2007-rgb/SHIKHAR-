rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Global Hardened Helpers ----------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number is string && request.auth.token.phone_number.size() > 0)
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true && 'email' in request.auth.token && request.auth.token.email == 'agastyashukla2007@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------- Entity Validation Blueprints ----------
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'targetExam', 'xp', 'streakDays', 'accuracyPercent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'targetExam', 'xp', 'streakDays', 'accuracyPercent', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.targetExam is string && data.targetExam in ['SSC', 'Railway', 'Banking', 'Defence', 'Police', 'Teaching', 'State PCS', 'All']
        && data.xp is int && data.xp >= 0 && data.xp <= 10000000
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650
        && (data.accuracyPercent is int || data.accuracyPercent is float) && data.accuracyPercent >= 0 && data.accuracyPercent <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'authProvider', 'whatsappOptIn', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phoneNumber', 'authProvider', 'whatsappOptIn', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.authProvider is string && data.authProvider in ['google', 'phone']
        && data.whatsappOptIn is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data, userId) {
      return data.keys().hasAll(['uid', 'quizId', 'title', 'subject', 'exam', 'score', 'maxScore', 'correctCount', 'incorrectCount', 'unansweredCount', 'accuracyPercent', 'avgTimePerQuestionSec', 'createdAt'])
        && data.keys().hasOnly(['uid', 'quizId', 'title', 'subject', 'exam', 'score', 'maxScore', 'correctCount', 'incorrectCount', 'unansweredCount', 'accuracyPercent', 'avgTimePerQuestionSec', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.quizId is string && data.quizId.size() >= 1 && data.quizId.size() <= 160
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.exam is string && data.exam.size() >= 1 && data.exam.size() <= 40
        && (data.score is int || data.score is float) && data.score >= -1000 && data.score <= 10000
        && (data.maxScore is int || data.maxScore is float) && data.maxScore >= 0 && data.maxScore <= 10000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500
        && data.incorrectCount is int && data.incorrectCount >= 0 && data.incorrectCount <= 500
        && data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= 500
        && (data.accuracyPercent is int || data.accuracyPercent is float) && data.accuracyPercent >= 0 && data.accuracyPercent <= 100
        && (data.avgTimePerQuestionSec is int || data.avgTimePerQuestionSec is float) && data.avgTimePerQuestionSec >= 0 && data.avgTimePerQuestionSec <= 3600
        && data.createdAt is timestamp;
    }

    function isValidSavedStudyItem(data, userId) {
      return data.keys().hasAll(['uid', 'itemType', 'refId', 'title', 'subject', 'createdAt'])
        && data.keys().hasOnly(['uid', 'itemType', 'refId', 'title', 'subject', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.itemType is string && data.itemType in ['bookmark', 'mistake', 'vocab']
        && data.refId is string && data.refId.size() >= 1 && data.refId.size() <= 160
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidAdminMember(data, userId) {
      return data.keys().hasAll(['uid', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'grantedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.grantedAt is timestamp;
    }

    // ---------- Collection Rules ----------
    match /test/connection {
      allow get: if true;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid is string && isAdmin();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidAdminMember(incoming(), userId) && isAdmin();
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid is string && isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwner(userId);

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'targetExam', 'xp', 'streakDays', 'accuracyPercent', 'updatedAt']))
        );

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneNumber', 'authProvider', 'whatsappOptIn', 'updatedAt']))
          );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(docId) && isAdmin();
      }

      match /attempts/{attemptId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(attemptId)
          && isValidQuizAttempt(incoming(), userId)
          && incoming().createdAt == request.time
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
      }

      match /savedItems/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(itemId)
          && isValidSavedStudyItem(incoming(), userId)
          && incoming().createdAt == request.time
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
